# Copy to .env.local and fill in. Both are OPTIONAL — with the variables
# absent, no analytics script is rendered, nothing is fetched, and there are
# no console warnings. See components/layout/Analytics.tsx.

# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_ID=

# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=

# URL of the backend service, no trailing slash. REQUIRED for the contact
# form to save leads and for /admin. Inlined at build time — on Railway set
# it before deploying, and redeploy after changing it.
# Local:   http://localhost:4000
# Railway: https://${{backend.RAILWAY_PUBLIC_DOMAIN}}
NEXT_PUBLIC_API_URL=
