# Copy to .env for local development. On Railway, set these as service
# variables instead — see the root README.

PORT=4000

# Local Postgres, e.g. from: docker run -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:17
# On Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:dev@localhost:5432/postgres
DATABASE_SSL=false

# The public site's origin(s), comma-separated, no trailing slash.
CORS_ORIGINS=http://localhost:3000

# The password for /admin. At least 10 characters.
ADMIN_PASSWORD=

# Signs admin sessions. Generate with: openssl rand -base64 48
SESSION_SECRET=
